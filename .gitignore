# Archivos de compilación y Gradle (Los más pesados)
*.apk
*.ap_
*.aab
*.dex
*.class
**/build/
.gradle/

# Archivos de configuración local (¡Muy importante ignorar esto!)
# Aquí es donde Android Studio guarda la ruta del SDK de tu computadora
local.properties

# Archivos de Android Studio y el entorno (Archivos personales de la ventana)
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
# Ignorar todos los archivos .iml (generados automáticamente por Android Studio)
*.iml

# Carpetas de generación de C++ (si llegas a usar NDK en el futuro)
.cxx/
.externalNativeBuild/

# Archivos de perfiles y capturas de memoria (Debugging)
captures/
*.hprof

# Archivos de firmas y claves (¡Por seguridad, nunca los subas a GitHub!)
*.jks
*.keystore

# Archivos basura del sistema operativo (Mac y Windows)
.DS_Store
Thumbs.db